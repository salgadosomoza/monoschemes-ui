{
  "name": "@monoschemes/ui",
  "version": "0.5.0",
  "description": "MonoSchemes monochrome React design system — tokens, components and themes synced with Figma",
  "keywords": [
    "design-system",
    "react",
    "components",
    "tokens",
    "figma",
    "dark-mode",
    "monochrome",
    "ui"
  ],
  "license": "MIT",
  "author": "Carlos Salgado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salgadosomoza/monoschemes-ui.git"
  },
  "homepage": "https://monoschemes.salgadosomoza.com/",
  "bugs": {
    "url": "https://github.com/salgadosomoza/monoschemes-ui/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt",
    "docs/agent-package",
    "skills/monoschemes-ui",
    "src/tokens/components.json",
    "src/tokens/tokens.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "check:dist": "node scripts/check-dist-css.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "build:storybook": "storybook build",
    "postbuild:storybook": "node -e \"require('node:fs').copyFileSync('llms.txt', 'storybook-static/llms.txt')\"",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitejs/plugin-react": "^4",
    "eslint": "^8",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^4",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.3.3",
    "jsdom": "^31.0.0",
    "prettier": "^3",
    "storybook": "^10.3.3",
    "storybook-addon-pseudo-states": "^10.3.3",
    "typescript": "^5",
    "vite": "^5",
    "vite-plugin-dts": "^3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tabler/icons-react": "3.52.0"
  }
}
